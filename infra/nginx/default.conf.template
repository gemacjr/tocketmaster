# Edge router + static host for the React SPA.
# nginx's official image envsubst-renders *.template files at container start.

upstream event_svc   { server ${EVENT_UPSTREAM};   }
upstream search_svc  { server ${SEARCH_UPSTREAM};  }
upstream booking_svc { server ${BOOKING_UPSTREAM}; }
upstream queue_svc   { server ${QUEUE_UPSTREAM};   }

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ---- SPA static assets (long-lived, content-hashed) ------------------------
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---- API routing (mirrors the ALB listener rules in AWS) -------------------
    location /api/events      { proxy_pass http://event_svc;   include /etc/nginx/tm_proxy.conf; }
    location /api/admin/events { proxy_pass http://event_svc;  include /etc/nginx/tm_proxy.conf; }

    location /api/search       { proxy_pass http://search_svc; include /etc/nginx/tm_proxy.conf; }
    location /api/admin/search { proxy_pass http://search_svc; include /etc/nginx/tm_proxy.conf; }

    location /api/bookings     { proxy_pass http://booking_svc; include /etc/nginx/tm_proxy.conf; }
    location /api/payments     { proxy_pass http://booking_svc; include /etc/nginx/tm_proxy.conf; }
    location /api/users        { proxy_pass http://booking_svc; include /etc/nginx/tm_proxy.conf; }

    location /api/queue/       { proxy_pass http://queue_svc;   include /etc/nginx/tm_proxy.conf; }
    location /api/admin/queue  { proxy_pass http://queue_svc;   include /etc/nginx/tm_proxy.conf; }

    # SSE stream: disable buffering so position events flush immediately
    location ~ ^/api/queue/events/[^/]+/stream$ {
        proxy_pass http://queue_svc;
        include /etc/nginx/tm_proxy.conf;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        chunked_transfer_encoding on;
    }

    # ---- SPA fallback -----------------------------------------------------------
    location = /index.html {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }
    location / {
        try_files $uri /index.html;
    }
}
